@dataclass
class JobConfig:
    name: str
    concurrency: int = 4
    @retry(
        times=5,
        delay=0.5,
    )
    async def run(self, payload: dict) -> str:
        def inner_helper(x: int) -> int:
            return x + 1
        result = inner_helper(self.concurrency)
        await asyncio.sleep(0)
        return f"{self.name}:{result}:{len(payload)}"
